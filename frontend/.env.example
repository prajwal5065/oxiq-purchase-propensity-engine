# Leave unset to use the Vite dev-server proxy (see vite.config.ts) in dev,
# or in a same-origin production deployment where the backend is reachable
# at /api on the same host as the built frontend - client.ts falls back to
# calling paths like "/companies" under a literal "/api" prefix in that
# case, matching how all API routes are mounted in app/main.py.
#
# Set this when the frontend and backend are on different origins. Include
# the /api suffix - e.g. https://api.example.com/api - since client.ts
# always appends bare paths like "/companies", never "/api/companies".
VITE_API_BASE_URL=
