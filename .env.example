# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me

# --- Database ---
DATABASE_URL=postgresql+asyncpg://oxiq:oxiq@localhost:5432/oxiq
DATABASE_URL_SYNC=postgresql+psycopg2://oxiq:oxiq@localhost:5432/oxiq

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Search / News ---
TAVILY_API_KEY=
GOOGLE_NEWS_RSS_BASE=https://news.google.com/rss/search

# --- Crawling ---
CRAWL4AI_HEADLESS=true
CRAWL4AI_TIMEOUT_SECONDS=30

# --- Feature flags (useful when keys are absent) ---
ENABLE_LIVE_SEARCH=false
ENABLE_LIVE_CRAWL=false
ENABLE_LIVE_TECH_DETECTION=false
ENABLE_LIVE_LLM=false
