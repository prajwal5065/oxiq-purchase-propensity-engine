# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me

# --- Database (Neon PostgreSQL) ---
# Use the asyncpg driver for the async engine (FastAPI / SQLAlchemy async).
# Note: asyncpg uses ssl=require (not sslmode=require which is psycopg2/libpq syntax).
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
# Use the psycopg2 driver for the sync engine (Alembic offline mode / sync helpers).
DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<password>@<host>/<dbname>?sslmode=require

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Search / News ---
TAVILY_API_KEY=
GOOGLE_NEWS_RSS_BASE=https://news.google.com/rss/search

# --- GitHub (no key required - unauthenticated 60 req/hr; token raises the limit) ---
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# --- Crawling ---
CRAWL4AI_HEADLESS=true
CRAWL4AI_TIMEOUT_SECONDS=30

# --- Company & Technology Intelligence (free/unauthenticated sources - no key required) ---
COMPANY_PROFILE_TIMEOUT_SECONDS=15
WIKIDATA_API_BASE=https://www.wikidata.org/w/api.php

# --- Feature flags (useful when keys are absent) ---
ENABLE_LIVE_SEARCH=false
ENABLE_LIVE_CRAWL=false
ENABLE_LIVE_TECH_DETECTION=false
ENABLE_LIVE_LLM=false
ENABLE_LIVE_GITHUB=false
ENABLE_LIVE_COMPANY_PROFILE=false
